.vercel
.env*
packages/*.zip

# Build output — generated by tools/embed-packages.js (the buildCommand already
# declared in vercel.json) from packages/. It is 70 MB and fully derivable, so it
# must never be committed: committing it bloated the repo to 124 MB and made
# every clone carry a file the build regenerates. The e2e suite needs it, so CI
# runs the build before the tests.
api/lib/*.generated.js
